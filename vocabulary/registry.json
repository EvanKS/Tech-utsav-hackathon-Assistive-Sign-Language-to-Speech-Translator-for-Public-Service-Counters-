        "HELLO":    { "label": "Hello",     "recognition_supported": true, "sources": ["video"] },
        "NO":       { "label": "No",        "recognition_supported": true, "sources": ["video"] },
        "SORRY":    { "label": "Sorry",     "recognition_supported": true, "sources": ["video"] },
